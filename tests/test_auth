def test_valid_admin_login(client):
    response = client.post(
        "/token",
        json={"username": "admin", "password": "admin123"}
    )

    assert response.status_code == 200
    assert "access_token" in response.json()
    assert response.json()["token_type"] == "bearer"


def test_invalid_login(client):
    response = client.post(
        "/token",
        json={"username": "admin", "password": "wrongpassword"}
    )

    assert response.status_code == 401


def test_missing_token_cannot_create_product(client):
    response = client.post(
        "/products",
        json={
            "name": "Monitor",
            "price": 199.99,
            "stock": 10
        }
    )

    assert response.status_code == 401


def test_admin_can_create_product(client, admin_headers):
    response = client.post(
        "/products",
        headers=admin_headers,
        json={
            "name": "Monitor",
            "price": 199.99,
            "stock": 10
        }
    )

    assert response.status_code == 201


def test_customer_cannot_create_product(client, customer_headers):
    response = client.post(
        "/products",
        headers=customer_headers,
        json={
            "name": "Monitor",
            "price": 199.99,
            "stock": 10
        }
    )

    assert response.status_code == 403


def test_inventory_cannot_delete_product(client, inventory_headers):
    response = client.delete(
        "/products/1",
        headers=inventory_headers
    )

    assert response.status_code == 403